# Copy this file to ".env" and fill in ONE provider's key to enable
# LLM-generated answers. Without any key the pipeline still runs in "extractive"
# mode (returns the most relevant retrieved passages instead of a synthesised
# answer).
#
# Provider auto-detection order: GEMINI_API_KEY > ANTHROPIC_API_KEY.

# --- Option A: Google Gemini (default if set) ---
GEMINI_API_KEY=your-gemini-key-here
# Optional model override (default: gemini-2.5-flash).
# Other options: gemini-2.5-pro, gemini-2.0-flash
RAG_GEMINI_MODEL=gemini-2.5-flash

# --- Option B: Anthropic Claude (used only if GEMINI_API_KEY is NOT set) ---
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# RAG_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
